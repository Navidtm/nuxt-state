{
  "name": "nuxt-define-state",
  "version": "0.0.0",
  "description": "Define shared Nuxt state using the same Composition API you already use in composables.",
  "keywords": [
    "nuxt",
    "nuxt-module",
    "vue",
    "state",
    "composable"
  ],
  "license": "MIT",
  "author": "Navid Talebian",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/your-org/nuxt-define-state.git"
  },
  "homepage": "https://github.com/your-org/nuxt-define-state#readme",
  "bugs": {
    "url": "https://github.com/your-org/nuxt-define-state/issues"
  },
  "exports": {
    ".": {
      "types": "./dist/types.d.mts",
      "import": "./dist/module.mjs"
    }
  },
  "main": "./dist/module.mjs",
  "typesVersions": {
    "*": {
      ".": [
        "./dist/types.d.mts"
      ]
    }
  },
  "files": [
    "dist"
  ],
  "workspaces": [
    "playground"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.17.0",
  "scripts": {
    "prepack": "nuxt-module-build build",
    "dev": "pnpm dev:prepare && nuxt dev playground",
    "dev:build": "nuxt build playground",
    "dev:prepare": "nuxt-module-build build --stub && nuxt-module-build prepare && nuxt prepare playground",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:types": "vue-tsc --noEmit && pnpm --dir playground exec vue-tsc --noEmit"
  },
  "dependencies": {
    "@nuxt/kit": "^4.5.2"
  },
  "peerDependencies": {
    "nuxt": "^4.0.0"
  },
  "devDependencies": {
    "@nuxt/devtools": "^3.4.2",
    "@nuxt/eslint-config": "^1.17.0",
    "@nuxt/module-builder": "^1.0.3",
    "@nuxt/schema": "^4.5.2",
    "@nuxt/test-utils": "^4.1.0",
    "@types/node": "latest",
    "changelogen": "^0.6.2",
    "eslint": "^10.9.0",
    "happy-dom": "^20.8.3",
    "nuxt": "^4.5.2",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11",
    "vue": "^3.5.31",
    "vue-tsc": "^3.3.11"
  }
}

